# Copy to .env.local and fill in your values
# Never commit .env.local to version control

# ── Morpheus connection ───────────────────────────────────────────────────────
# NOTE: Morpheus URL and token are now stored per-admin in the database.
# These env vars are used only as a fallback if no DB config exists.
VITE_MORPHEUS_URL=https://your-morpheus-instance
# IMPORTANT: do NOT use VITE_ prefix for secrets (Vite ships those to the browser).
# This token is only used by the Vite dev proxy and stays server-side.
MORPHEUS_TOKEN=your-morpheus-token-here

# ── Task execution API ────────────────────────────────────────────────────────
# FastAPI backend host (no trailing slash). Backend now runs on port 8001.
VITE_TASK_API_FLASK=http://192.168.100.77:8005

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to 'true' to use live data, 'false' for mock data
VITE_USE_LIVE_DATA=true

# ── Auth / API base ───────────────────────────────────────────────────────────
VITE_AUTH_TARGET=http://localhost:8005
VITE_GLOBAL_VM_ADRESS=http://192.168.100.77

# Grafana UI embedded in Dashboards page (same host:port as backend GRAFANA_URL)
VITE_GRAFANA_URL=http://192.168.100.77:3000
# Optional: public dashboard access token for iframe embed (no Grafana login)
VITE_GRAFANA_PUBLIC_TOKEN=
