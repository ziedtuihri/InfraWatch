# Copy to .env.local and fill in your values
# Never commit .env.local to version control

# ── Morpheus connection ───────────────────────────────────────────────────────
VITE_MORPHEUS_URL=https://projet1-virtual-machine
# IMPORTANT: do NOT use VITE_ prefix for secrets (Vite ships those to the browser).
# This token is only used by the Vite dev proxy (vite.config.js) and stays server-side.
MORPHEUS_TOKEN=ea3c4b6b-4b64-47f5-9954-89e184ec3039

# ── Optional: API proxy path (if using the Vite proxy in vite.config.js) ─────
# Leave blank to call Morpheus directly from the browser (requires CORS to be
# enabled on your Morpheus instance, or use the proxy below)
VITE_API_BASE=/api

# ── Task execution API (POST /api/tasks/:id/execute) ─────────────────────────
# Host only (no /api suffix). Dev without this uses Vite /task-api proxy.
VITE_TASK_API_FLASK=http://10.202.52.94:8000

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to 'true' to use live Morpheus data, 'false' to use mock data
VITE_USE_LIVE_DATA=true

# ── Optional: Auth backend (for Login page) ───────────────────────────────────
# If set, /auth/* will be proxied to this target during `npm run dev`
VITE_AUTH_TARGET=http://localhost:8080
# Client base path used by the frontend (usually keep as /auth)
VITE_AUTH_BASE=http://10.202.52.94:8000

VITE_GLOBAL_VM_ADRESS=http://10.202.52.94


