# FastAPI backend environment variables

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://infra:postgres@localhost:5432/infrawatch

# ── Morpheus (fallback — overridden per-admin via DB) ────────────────────────
EXTERNAL_API_URL=https://your-morpheus-instance
EXTERNAL_API_TOKEN=your-morpheus-token-here
EXTERNAL_API_VERIFY_SSL=false
